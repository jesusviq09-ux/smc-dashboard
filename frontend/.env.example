# URL del backend en Railway (incluye /api al final)
# Ejemplo: https://smc-dashboard-production.up.railway.app/api
VITE_API_URL=https://tu-backend.up.railway.app/api

# Integración Echook (opcional)
VITE_ECHOOK_URL=
VITE_ECHOOK_KEY=

# OpenRouter AI — análisis táctico de estrategias (opcional, GRATIS sin tarjeta)
# 1. Crea cuenta en https://openrouter.ai (gratis, sin tarjeta de crédito)
# 2. Ve a https://openrouter.ai/keys y crea una clave
# 3. Pégala aquí y añádela en Vercel → Settings → Environment Variables
# Tier gratuito: 20 req/min, 200 req/día — modelo Llama 3.1 8B
VITE_OPENROUTER_API_KEY=
